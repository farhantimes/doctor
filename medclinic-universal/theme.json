{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "860px",
      "wideSize": "1240px"
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "primary",
          "color": "#0d9488",
          "name": "Clinical Primary"
        },
        {
          "slug": "primary-dark",
          "color": "#0f766e",
          "name": "Clinical Primary Dark"
        },
        {
          "slug": "primary-light",
          "color": "#ccfbf1",
          "name": "Clinical Primary Light"
        },
        {
          "slug": "secondary",
          "color": "#0f172a",
          "name": "Deep Medical Navy"
        },
        {
          "slug": "accent",
          "color": "#0284c7",
          "name": "Clinical Sky Accent"
        },
        {
          "slug": "base",
          "color": "#ffffff",
          "name": "Pure White"
        },
        {
          "slug": "surface",
          "color": "#f8fafc",
          "name": "Clinical Neutral Surface"
        },
        {
          "slug": "text",
          "color": "#1e293b",
          "name": "Charcoal Body Text"
        },
        {
          "slug": "muted",
          "color": "#64748b",
          "name": "Muted Slate"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Outfit', 'Plus Jakarta Sans', system-ui, sans-serif",
          "name": "Outfit (Headings)",
          "slug": "heading"
        },
        {
          "fontFamily": "'Plus Jakarta Sans', system-ui, -apple-system, sans-serif",
          "name": "Plus Jakarta Sans (Body)",
          "slug": "body"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "name": "Regular",
          "size": "1rem",
          "slug": "medium"
        },
        {
          "name": "Medium Large",
          "size": "1.25rem",
          "slug": "large"
        },
        {
          "name": "Extra Large",
          "size": "1.75rem",
          "slug": "x-large"
        },
        {
          "name": "Display 2X",
          "size": "2.5rem",
          "slug": "2x-large"
        },
        {
          "name": "Hero Headline",
          "size": "3.25rem",
          "slug": "hero"
        }
      ]
    },
    "spacing": {
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      },
      "units": ["px", "rem", "%", "vh", "vw"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "color": "var(--wp--preset--color--secondary)",
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700"
        }
      },
      "link": {
        "color": "var(--wp--preset--color--primary)",
        ":hover": {
          "color": "var(--wp--preset--color--primary-dark)"
        }
      },
      "button": {
        "border": {
          "radius": "8px"
        },
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "#ffffff"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "600",
          "fontSize": "1rem"
        }
      }
    }
  }
}
